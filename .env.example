# ============================================================
# Crittix Pterodactyl Bot - configuration
# Copy this file to ".env" and fill in your own values,
# OR set the same variables on your Pterodactyl server.
# NEVER share this file after filling it in.
# ============================================================

# Telegram bot token from @BotFather (generate a NEW one)
BOT_TOKEN=

# Owner / admin Telegram numeric IDs
OWNER_ID=8033024853
ADMIN_IDS=8033024853

# Your Pterodactyl panel
PTERODACTYL_URL=https://ptero.devine.name.ng

# Application API key from: Panel -> Admin -> Application API (generate a NEW one)
PTERODACTYL_API_KEY=

# Location: leave EMPTY to auto-detect the first location on the panel,
# or set a location ID / short code from Panel -> Admin -> Locations
PTERODACTYL_LOCATION_ID=

# Optional: force exact panel Egg IDs (leave empty to auto-detect by egg name
# "NODE JS" and "Python Engine")
PTERODACTYL_NODEJS_EGG_ID=
PTERODACTYL_PYTHON_EGG_ID=
